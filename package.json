{
  "name": "sunflower-animation-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Interactive Sunflower Animation Web Application",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"green.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "seed:backend": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend run test:api",
    "db:push": "npm --prefix backend run db:push",
    "db:studio": "npm --prefix backend run db:studio"
  },
  "keywords": [
    "sunflower",
    "canvas",
    "animation",
    "express",
    "prisma",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
